function bingo(ticket, win) {
let miniWins = 0; 

for (let i = 0; i < ticket.length; i++) {
const [str, num] = ticket[i];
let hasWin = false;
for (let j = 0; j < str.length; j++) {
    if (str.charCodeAt(j) === num) {
        hasWin = true;
        break;
    }
}

if (hasWin) {
    miniWins++;
}

}

return miniWins >= win ? 'Winner!' : 'Loser!';

}
